NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_VERSION=dev

# Public origin of the web app (links in emails, auth base URL, trusted origin)
APP_URL=http://localhost:3000
# Extra origins allowed to call the API with credentials (comma-separated)
CORS_ORIGINS=

DATABASE_URL=postgresql://billsplit:billsplit@localhost:5432/billsplit

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# smtp (Mailpit at http://localhost:8025) | ses | log
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=BillSplit <no-reply@localhost>

# Receipt images (RustFS from `pnpm docker:up` locally; leave RECEIPTS_BUCKET empty to disable)
RECEIPTS_BUCKET=billsplit-receipts
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=billsplit
S3_SECRET_KEY=billsplit-secret
