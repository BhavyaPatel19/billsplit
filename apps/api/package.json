{
  "name": "@billsplit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@billsplit/contracts": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@scalar/hono-api-reference": "0.12.18",
    "hono": "4.13.17",
    "hono-openapi": "1.5.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@billsplit/config": "workspace:*",
    "@types/node": "26.6.6",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
